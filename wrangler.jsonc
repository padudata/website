{
  "name": "padudata",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API runs the Worker; every other path is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padudata",
      "database_id": "274693cf-ffde-4d26-b32d-6a10e486074a",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "padudata.com", "custom_domain": true },
    { "pattern": "www.padudata.com", "custom_domain": true }
  ]
}
